    {
      "topic_id": "online_returns",
      "title_zh": "网购七日无理由退货",
      "scope_note": "依据《网络购买商品七日无理由退货暂行办法》的适用规则和退货程序。",
      "primary_source": "topics/online_returns/mineru/primary.txt",
      "facts": [
        {
          "fact_id": "O1",
          "claim": "消费者应当自收到商品之日起七日内向销售者发出退货通知，七日期间从签收商品的次日开始计算。",
          "evidence": [
            "primary.txt:63-65"
          ],
          "question_target": true,
          "error_candidate": true
        },
        {
          "fact_id": "O2",
          "claim": "销售者收到通知后，应及时提供真实准确的退货地址、联系人和联系电话。",
          "evidence": [
            "primary.txt:66-68"
          ],
          "question_target": false,
          "error_candidate": false
        },
        {
          "fact_id": "O3",
          "claim": "消费者获得退货信息后应及时退回商品，并保留退货凭证。",
          "evidence": [
            "primary.txt:69-70"
          ],
          "question_target": true,
          "error_candidate": false
        },
        {
          "fact_id": "O4",
          "claim": "退货时应将商品本身、配件和赠品一并退回。",
          "evidence": [
            "primary.txt:71-78"
          ],
          "question_target": true,
          "error_candidate": false
        },
        {
          "fact_id": "O5",
          "claim": "商品保持原有品质和功能，且商品本身、配件和商标标识齐全的，可视为商品完好。",
          "evidence": [
            "primary.txt:41-45"
          ],
          "question_target": true,
          "error_candidate": true
        },
        {
          "fact_id": "O6",
          "claim": "为查验商品而打开包装，或为确认品质和功能进行合理调试，不影响商品完好。",
          "evidence": [
            "primary.txt:41-45"
          ],
          "question_target": true,
          "error_candidate": true
        },
        {
          "fact_id": "O7",
          "claim": "商品完好的，销售者应在收到退回商品之日起七日内返还商品价款。",
          "evidence": [
            "primary.txt:79-80"
          ],
          "question_target": true,
          "error_candidate": true
        },
        {
          "fact_id": "O8",
          "claim": "退款方式原则上参照购买商品时的支付方式，另有约定的按约定处理。",
          "evidence": [
            "primary.txt:81-86"
          ],
          "question_target": false,
          "error_candidate": false
        },
        {
          "fact_id": "O9",
          "claim": "退货产生的运费依法由消费者承担，经营者与消费者另有约定的除外。",
          "evidence": [
            "primary.txt:101-104"
          ],
          "question_target": true,
          "error_candidate": true
        }
      ]
