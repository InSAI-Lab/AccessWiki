      "topic_id": "rail_travel",
      "title_zh": "火车/高铁出行",
      "scope_note": "依据铁路旅客运输规程及中国铁路12306身份证直接检票说明。",
      "primary_source": "topics/rail_travel/mineru/primary.txt",
      "supplementary_source": "topics/rail_travel/mineru/supplementary.txt",
      "facts": [
        {
          "fact_id": "R1",
          "claim": "车票可采用纸质或电子数据形式，通常载明发站、到站、车次、车厢号、席别、席位号、票价和开车时间等信息。",
          "evidence": [
            "primary.txt:34-37"
          ],
          "question_target": true,
          "error_candidate": false
        },
        {
          "fact_id": "R2",
          "claim": "旅客应按照有效车票载明的时间、车次、车厢号、席别和席位号乘车。",
          "evidence": [
            "primary.txt:146-148"
          ],
          "question_target": true,
          "error_candidate": false
        },
        {
          "fact_id": "R3",
          "claim": "旅客及其随身携带物品需要接受安全检查，并遵守禁止或限制运输物品的相关规定。",
          "evidence": [
            "primary.txt:128-134"
          ],
          "question_target": true,
          "error_candidate": false
        },
        {
          "fact_id": "R4",
          "claim": "车站等公共场所应设置安全标志、导向系统和信息服务系统。",
          "evidence": [
            "primary.txt:144-145"
          ],
          "question_target": false,
          "error_candidate": false
        },
        {
          "fact_id": "R5",
          "claim": "使用居民身份证直接检票进站时，如果闸机不放行，应持身份证原件到售票窗口换取纸质车票；身份证无法自动识读时还需提供订单号码。",
          "evidence": [
            "supplementary.txt:117-119"
          ],
          "question_target": true,
          "error_candidate": true
        },
        {
          "fact_id": "R6",
          "claim": "铁路运输企业应为老年人和其他需要帮助的旅客提供必要的人工服务。",
